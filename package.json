{
  "name": "telegram-downloader-extension",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "A privacy-first Telegram Web media downloader for Chrome.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
