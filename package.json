  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "esbuild": "^0.25.9",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
