{
  "manifest_version": 3,
  "name": "Telegram Media Downloader",
  "version": "0.1.11",
  "minimum_chrome_version": "116",
  "description": "Download visible photos and videos from Telegram Web to a folder you choose.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Telegram Media Downloader",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/k/*"
      ],
      "js": ["content/injector.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.telegram.org/k/*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.html", "bridge.js"],
      "matches": [
        "https://web.telegram.org/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
